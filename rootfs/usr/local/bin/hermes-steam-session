#!/usr/bin/env bash
# Per-session Steam Big Picture launcher, invoked by Hermes as the "cmd" of the
# "Steam Big Picture" app (see entrypoint.sh / apps.json). Hermes runs this as
# root when a client starts the app and exports the stream's negotiated geometry
# in SUNSHINE_CLIENT_WIDTH/HEIGHT/FPS.
#
# Steam can run in two places, selected by STEAM_GAMESCOPE:
#   * false (default) — directly on the sway session, as a normal client of
#     sway's Xwayland. The streamed output is already sized by Hermes, so the
#     picture is still native; this is the compatible path when gamescope's
#     Xwayland cannot hand a game a usable GL drawable ("failed to create
#     drawable") or a game only behaves on a plain desktop.
#   * true — nested inside gamescope, sized to exactly what the client asked for
#     (no upscaling), with gamescope's FSR/HDR and per-session refresh clamping.
# It runs as the non-root "steam" user (Steam refuses to run as root). When the
# client disconnects Hermes terminates this process group, tearing the session
# down — that's the "relaunch per connection" model (Steam is not kept warm).
set -euo pipefail

STEAM_LOG=/var/log/steam.log
if [ -f "${STEAM_LOG}" ]; then
    log_size="$(wc -c <"${STEAM_LOG}" 2>/dev/null || echo 0)"
    [ "${log_size}" -gt 5242880 ] && mv -f "${STEAM_LOG}" "${STEAM_LOG}.1" 2>/dev/null || true
fi
exec >>"${STEAM_LOG}" 2>&1

log()  { printf '\033[0;36m[hermes-steam]\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[0;33m[hermes-steam][warn]\033[0m %s\n' "$*" >&2; }

log "=== session start $(date '+%F %T %Z') ==="

command -v steam >/dev/null 2>&1     || { warn "steam not installed"; exit 0; }
id steam >/dev/null 2>&1             || { warn "no 'steam' user"; exit 0; }
[ "${AUTOSTART_STEAM:-true}" = "true" ] || { log "AUTOSTART_STEAM=false"; exit 0; }
[ -n "${WAYLAND_DISPLAY:-}" ]        || { warn "no Wayland session"; exit 1; }
[ -n "${XDG_RUNTIME_DIR:-}" ]        || { warn "XDG_RUNTIME_DIR unset"; exit 1; }

W="${SUNSHINE_CLIENT_WIDTH:-${DISPLAY_WIDTH:-1920}}"
H="${SUNSHINE_CLIENT_HEIGHT:-${DISPLAY_HEIGHT:-1080}}"
R="${SUNSHINE_CLIENT_FPS:-${DISPLAY_REFRESH:-60}}"
log "launching Steam Big Picture at ${W}x${H}@${R}"

runtime="/run/user/$(id -u steam)"
sockpath="${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}"

install -d -o steam -g steam -m 700 "${runtime}" 2>/dev/null || true
chmod o+x "${XDG_RUNTIME_DIR}" 2>/dev/null || true
chmod o+rw "${sockpath}" 2>/dev/null || true

TZ_ENV=()
[ -n "${TZ:-}" ] && TZ_ENV=(TZ="${TZ}")

# D-Bus session bus. Since the 2026-10-16 client build Steam starts through the
# SteamRT3 client: it re-execs itself into the Steam Linux Runtime
# ("ReexecToLauncher: steamrt3 client enabled" -> "ReexecSteamLinux: re-launching
# steam in SteamRT runtime"), and steam-runtime-launcher-service needs a D-Bus
# *session* bus for that hand-off. This container only runs a system bus
# (entrypoint.sh), so without one the launcher service dies with
#
#   steam-runtime-launcher-service: E: Can't find session bus: ... dbus-launch
#       --autolaunch=... exited with code 1
#   srt-client-container: E: Couldn't start subprocess launcher: exited code 69
#   ReexecSteamLinux: exiting
#
# and steam itself returns 125 within a second, leaving the stream on the plain
# desktop (the "Steam exited (rc=125) after 0s" loop in /var/log/steam.log).
# Give every stream session its own session bus by starting one as the steam user
# with the socket in its runtime dir — the same XDG_RUNTIME_DIR the SteamRT3
# sandbox shares, so both the launcher service (outside) and the client (inside)
# can reach it. dbus-run-session tears the bus down with the session.
# Always start our own bus, even when DBUS_SESSION_BUS_ADDRESS is already set.
# That inherited address is not ours to use: it belongs to the session root
# started (an earlier design ran a separate bus for the compositor), and the
# steam user cannot connect to that socket. Trusting it made Steam exit 125 in a
# loop. dbus-run-session overrides the variable for its children, so the SteamRT3
# launcher service always gets a bus it can actually reach.
DBUS_WRAP=()
if command -v dbus-run-session >/dev/null 2>&1; then
    # A hard-killed previous session can leave the socket behind, and dbus-daemon
    # then refuses to bind it; nothing else can own it here (single session host).
    if [ -S "${runtime}/bus" ]; then
        rm -f "${runtime}/bus"
    fi
    DBUS_WRAP=(dbus-run-session --)
else
    warn "dbus-run-session missing: Steam's SteamRT3 launcher will fail without a session bus"
fi

# Where Steam runs (see the header): "false" = directly on the sway session,
# "true" = nested inside gamescope.
STEAM_GAMESCOPE="${STEAM_GAMESCOPE:-false}"

# Ask sway which X display its Xwayland ended up on. Steam's UI is X11, and the
# display number is not fixed (sway takes the first free one, which shifts
# depending on whether anything else already holds :0), so a DISPLAY inherited
# from the container environment can point nowhere. "swaymsg exec" runs with the
# compositor's own environment, which has the right DISPLAY.
sway_x_display() {
    [ -n "${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null 2>&1 || return 1
    out="/tmp/.hermes-xdisplay.$$"
    rm -f "${out}"
    swaymsg -q exec "printf %s \"\$DISPLAY\" > ${out}" >/dev/null 2>&1 || return 1
    for _ in $(seq 1 20); do
        if [ -s "${out}" ]; then
            sed -n '1p' "${out}"
            break
        fi
        sleep 0.05
    done
    rm -f "${out}"
}

COMPOSITOR_CMD=()
XENV=()
if [ "${STEAM_GAMESCOPE}" = "true" ]; then
    command -v gamescope >/dev/null 2>&1 || { warn "gamescope not installed"; exit 0; }
    COMPOSITOR_CMD=(gamescope -W "${W}" -H "${H}" -r "${R}" -f -e --)
    XENV=(XDG_CURRENT_DESKTOP=gamescope)
    log "compositor: gamescope ${W}x${H}@${R}"
else
    xdisp="$(sway_x_display 2>/dev/null || true)"
    [ -n "${xdisp}" ] || xdisp="${DISPLAY:-:0}"
    XENV=(DISPLAY="${xdisp}" XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-sway}")
    log "compositor: ${XDG_CURRENT_DESKTOP:-sway} (Steam on the session directly, DISPLAY=${xdisp})"
fi

# Big Picture minimizes itself as soon as it loses focus — i.e. the moment a game
# window takes over. Inside this nested gamescope that looks exactly like "the
# game crashed and the stream fell back to the desktop": the game keeps running
# and rendering (its Gamescope WSI surface stays alive), but the focused window is
# gone, so gamescope paints its root window instead. SDL hint; see "Big Picture
# Mode minimizes itself after losing focus" in the ArchWiki Steam/Troubleshooting
# page. Comments must stay OUTSIDE the list below — a '#' anywhere inside a
# backslash-continued command swallows the rest of it.
# X11 auth: sway's Xwayland runs without access control, so XAUTHORITY stays
# unset and X11 clients (Steam) connect without a cookie. Forward it only when
# something in the environment did set it.
XAUTH_ENV=()
[ -n "${XAUTHORITY:-}" ] && XAUTH_ENV=(XAUTHORITY="${XAUTHORITY}")

# xwayland creates its socket with sway's umask (0755 under root), and connecting
# to a UNIX socket needs write permission: without this the steam user gets
# "Unable to open a connection to X" while root succeeds. It is also re-fixed by
# the entrypoint's watchdog; do it here so a session always starts connectable.
chmod 1777 /tmp/.X11-unix 2>/dev/null || true
chmod 0666 /tmp/.X11-unix/X* 2>/dev/null || true

# Xwayland runs without -auth, so it only accepts its own uid (root); grant the
# steam user explicitly. Harmless if the entrypoint already did it.
if [ "${STEAM_GAMESCOPE}" != "true" ] && command -v xhost >/dev/null 2>&1; then
    DISPLAY="${XENV[0]#DISPLAY=}" xhost +SI:localuser:steam >/dev/null 2>&1 || true
fi

exec runuser -u steam -- env \
    HOME=/config/steam \
    XDG_RUNTIME_DIR="${runtime}" \
    WAYLAND_DISPLAY="${sockpath}" \
    PULSE_SERVER="${PULSE_SERVER:-unix:/run/pipewire/pulse/native}" \
    "${XENV[@]}" \
    "${XAUTH_ENV[@]}" \
    SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0 \
    "${TZ_ENV[@]}" \
    "${DBUS_WRAP[@]}" \
    "${COMPOSITOR_CMD[@]}" \
    bash -c '
        delay=2; max=60
        while :; do
            SECONDS=0
            steam -gamepadui
            rc=$?
            ran=$SECONDS
            [ "${ran}" -ge 30 ] && delay=2
            printf "[hermes-steam] Steam exited (rc=%s) after %ss; relaunching in %ss\n" "${rc}" "${ran}" "${delay}"
            sleep "${delay}"
            [ "${ran}" -lt 30 ] && { delay=$(( delay * 2 )); [ "${delay}" -gt "${max}" ] && delay="${max}"; }
        done
    '