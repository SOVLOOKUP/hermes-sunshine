#!/bin/sh
# Prevent file descriptor leakage into background daemon
for fd in /proc/self/fd/*; do
    f="${fd##*/}"
    if [ "$f" -ge 3 ] 2>/dev/null; then
        eval "exec $f>&-" 2>/dev/null || true
    fi
done
for real in /usr/bin/xclip.real /usr/local/bin/xclip.real; do
    if [ -x "$real" ]; then
        exec "$real" "$@"
    fi
done
exit 0
