#!/usr/bin/env bash
# Manage outputs and keep sway's focus on the streamed Virtual-1 output.
#
# Hermes unplugs and replugs the per-session "Virtual-1" DRM connector on every
# app switch. While it is gone, sway needs HEADLESS-1 active so sway does not
# exit and Hermes can activate virtual outputs.
#
# When Virtual-1 is hotplugged, sway auto-assigns it to the right of HEADLESS-1
# (e.g. 5120,0), which makes Xwayland treat the 720p HEADLESS-1 as the primary
# display (Display 0) and confuses games (e.g. 4K option disappears, rendering
# in a tiny top-left box).
#
# This watcher:
# 1. When Virtual-1 is present:
#    - Moves Virtual-1 to (0,0) as primary
#    - Disables HEADLESS-1 so X11/Xwayland only sees Virtual-1
#    - Moves focus to Virtual-1 / workspace 1
# 2. When Virtual-1 is gone:
#    - Re-enables HEADLESS-1 at (0,0) to hold the compositor
set -euo pipefail

# Ensure single instance across sway config reloads
PIDFILE="/run/hermes/hermes-focus-watch.pid"
if [ -f "${PIDFILE}" ]; then
    old_pid="$(cat "${PIDFILE}" 2>/dev/null || true)"
    if [ -n "${old_pid}" ] && [ "${old_pid}" != "$$" ] && kill -0 "${old_pid}" 2>/dev/null; then
        kill "${old_pid}" 2>/dev/null || true
    fi
fi
mkdir -p /run/hermes 2>/dev/null || true
echo "$$" > "${PIDFILE}" 2>/dev/null || true

has_virtual1() {
    swaymsg -t get_outputs 2>/dev/null | jq -e '.[] | select(.name=="Virtual-1" and .active==true)' >/dev/null 2>&1
}

has_headless() {
    swaymsg -t get_outputs 2>/dev/null | jq -e '.[] | select(.name=="HEADLESS-1" and .active==true)' >/dev/null 2>&1
}

# State caching to avoid redundant IPC calls while the session is running
CURRENT_STATE="unknown"

process_event() {
    if has_virtual1; then
        if [ "${CURRENT_STATE}" != "streaming" ]; then
            # Ensure Virtual-1 is at (0, 0) and HEADLESS-1 is disabled
            swaymsg 'output "Virtual-1" position 0 0' >/dev/null 2>&1 || true
            if has_headless; then
                swaymsg 'output "HEADLESS-1" disable' >/dev/null 2>&1 || true
            fi
            swaymsg 'workspace 1' >/dev/null 2>&1 || true
            CURRENT_STATE="streaming"
        fi
    else
        if [ "${CURRENT_STATE}" != "idle" ]; then
            # Virtual-1 is absent/disconnected: revive HEADLESS-1 to prevent sway from idling with 0 outputs
            if ! has_headless; then
                swaymsg 'output "HEADLESS-1" enable; output "HEADLESS-1" position 0 0; output "HEADLESS-1" resolution 1280x720' >/dev/null 2>&1 || true
                swaymsg 'workspace 1' >/dev/null 2>&1 || true
            fi
            # Clean up lingering clipboard daemons that may hold leaked socket fds (e.g. UDP 47999)
            killall -9 wl-copy wl-paste xclip 2>/dev/null || true
            CURRENT_STATE="idle"
        fi
    fi
}

while :; do
    CURRENT_STATE="unknown"
    process_event
    if command -v swaymsg >/dev/null 2>&1; then
        swaymsg -t subscribe -m '["output","workspace"]' 2>/dev/null | while read -r _; do
            process_event
        done || true
    fi
    sleep 2
done
